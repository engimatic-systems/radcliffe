port: 7880
log_level: info
prometheus_port: 6789

rtc:
  tcp_port: 7881
  port_range_start: 50000
  port_range_end: 60000
  use_external_ip: true

keys:
  ${LIVEKIT_API_KEY}: ${LIVEKIT_API_SECRET}

turn:
  enabled: true
  domain: ${TURN_DOMAIN}
  tls_port: 443
  udp_port: 3478
  cert_file: ${TURN_CERT_FILE}
  key_file: ${TURN_KEY_FILE}
